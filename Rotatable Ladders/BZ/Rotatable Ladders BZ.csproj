<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Game>BZ</Game>
        <GameDir>$(BelowZeroDir)</GameDir>
        <DefineConstants>$(DefineConstants);BELOWZERO</DefineConstants>
        <RootNamespace>Rotatable_Ladders</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\src\**\*.cs" LinkBase="src"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.21"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0"/>
        <PackageReference Include="SubnauticaZero.Nautilus" Version="1.0.0-pre.54"/>
        <PackageReference Include="UnityEngine.Modules" Version="2019.4.36" IncludeAssets="compile"/>
        <PackageReference Include="Subnautica.BelowZero.GameLibs" Version="53115.0.0-r.0"/>
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>

</Project>
